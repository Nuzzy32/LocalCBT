<?xml version="1.0" encoding="UTF-8"?>
<!-- M1-04 spike: API sebagai launchd daemon, hidup terlepas dari Control Center.
     Template: ganti __API_DIR__ lalu salin ke /Library/LaunchDaemons/ (perlu admin).
     Installer sungguhan (runtime Python terisolasi, signing/notarization) = M8. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>id.localcbt.api</string>
	<key>WorkingDirectory</key>
	<string>__API_DIR__</string>
	<key>ProgramArguments</key>
	<array>
		<string>__API_DIR__/.venv/bin/uvicorn</string>
		<string>app.main:app</string>
		<string>--host</string>
		<string>127.0.0.1</string>
		<string>--port</string>
		<string>8000</string>
		<string>--no-access-log</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Library/Logs/LocalCBT/api.log</string>
</dict>
</plist>
